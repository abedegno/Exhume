index 0000000..6a335cf
--- /dev/null
+++ b/src/trace.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+
+extern int trace_on;
+extern uint32_t trace_prov[];
+extern uint32_t trace_rt[8];
+extern uint32_t trace_last_rd, trace_last_rdb, trace_wt, trace_bt;
+extern uint32_t trace_ea_t[2];
+extern uint16_t trace_ea_v[2];
+extern unsigned trace_dgroup;
+
+void trace_init(void);
+void trace_program(FILE *f);
+void trace_loaded(FILE *f, long pos, uint32_t addr, unsigned n);
+void trace_use(uint32_t t);
+void trace_use_at(uint32_t t, unsigned seg, uint16_t disp, uint16_t value);
+void trace_set_load(unsigned load_seg);
+void trace_code(uint32_t t);
+void trace_exec(uint32_t lin);
+extern uint32_t trace_rd_lo, trace_rd_hi;
+void trace_read(uint32_t t);
