diff --git a/src/record.c b/src/record.c
new file mode 100644
index 0000000..64895c3
--- /dev/null
+++ b/src/record.c
@@ -0,0 +1,569 @@
+/* Call recording for emu2 (Exhume): what a function of the program reads and what it changes,
+ * call by call, so that a translation of the function can be run from the same state and
+ * compared.
+ *
+ * EMU2_RECORD=OUTFILE         write records to OUTFILE.PID (needs nothing else; turns on the
+ *                             provenance tracing of trace.c, which tells where code came from)
+ * EMU2_RECORD_AT=OFF[,OFF...] hex program-file offsets of the functions' first instructions.
+ *                             A function is known by where its code came from in the file, so
+ *                             overlay code loaded anywhere is found too.
+ * EMU2_RECORD_INNER=OFF[,...] functions recorded as children of the recorded calls they are
+ *                             made in: the calls a translation of those functions makes to
+ *                             functions not yet translated, which a replay can then answer.
+ * EMU2_RECORD_IGNORE=LO-HI[,LO-HI...]
+ *                             hex program-file ranges of code whose work is not recorded (an
+ *                             overlay manager: it loads overlays and keeps its own state when
+ *                             one overlay calls into another, which no translation does).
+ *                             From the first instruction of such code until execution leaves
+ *                             it at the stack level it entered with, nothing read or written
+ *                             (by the code it calls and by DOS too) counts for any call, and
+ *                             no call starts a record.  What it writes is kept, though: as part
+ *                             of a child running at the time, or else as external writes
+ *                             (X lines) that a replay applies at the next child.  When it
+ *                             calls back into the program's own code and that code writes
+ *                             (the overlay manager asking for memory, pools moved), the calls
+ *                             open at the time are not written: no replay can tell when.
+ * EMU2_RECORD_MAX=N           records per EMU2_RECORD_AT function (default 20): the first N/2
+ *                             calls; then calls that had children (the rare paths, such as a
+ *                             pool that grows), and a sample spread over the run, each twice
+ *                             as far on as the last.
+ *
+ * Calls nest: a recorded function called inside another recorded call is recorded too, with
+ * its own record, up to 32 deep (a call deeper than that leaves every enclosing call
+ * unrecorded, since their records would miss it).  A call ends at the step after it executes
+ * a return with SP at its return address (wherever that goes: the overlay manager may have
+ * moved the caller and rewritten the address), or when execution reaches its return address with
+ * SP above its value at entry (the caller's code may have moved meanwhile: an overlay the
+ * heap moved).  A call the stack unwinds past without a return (a long jump) is not
+ * written, nor are the calls around it.  A child is a call of an EMU2_RECORD_INNER function; it belongs to every
+ * recorded call that encloses it with no other child in between (a function a translation
+ * calls directly or through other translated functions), and calls made inside a child are
+ * not recorded.  Each record is
+ *     CALL off seq
+ *     PARENT off seq index                               (children only, one per parent) the
+ *                                                        parent's CALL line, and this child's
+ *                                                        place among its children; then
+ *       X lin bytes                                      bytes the ignored code wrote since the
+ *                                                        parent's last child, as they were when
+ *                                                        this one started
+ *     IN  AX BX CX DX SP BP SI DI ES CS SS DS FLAGS      registers at entry (hex)
+ *     S bytes                                            the 32 bytes at SS:SP at entry: the
+ *                                                        return address and the arguments
+ *     R lin bytes                                        memory read before it was written,
+ *                                                        with the value it had (runs, hex)
+ *     OUT AX BX CX DX SP BP SI DI ES CS SS DS FLAGS      registers at the return address
+ *     W lin bytes                                        memory written, final values
+ *     X lin bytes                                        bytes the ignored code wrote after the
+ *                                                        last child, as they were at the end
+ *     STEPS n                                            instructions executed
+ *     FRAME sp                                           the lowest SP of the call: its own
+ *                                                        frame runs from there to its entry SP
+ *     BIOS n                                             (only if n > 0) DOS or BIOS calls made
+ *     END
+ * A record comes after the records of everything it encloses.  The children of a call not
+ * kept stay in the file without it.  Bytes below the entry SP in the stack segment (the
+ * call's own frame) are left out of W.  Memory the emulated DOS writes (a file read into a
+ * buffer) is found by comparing memory from the program's PSP up before and after each DOS
+ * or BIOS call and counts as written, by the ignored code when it made the call (an overlay
+ * read from the EXE); what DOS reads is not seen. */
+#include "record.h"
+#include "cpu.h"
+#include "emu.h"
+#include "trace.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define MEM (1u << 20)
+#define MAX_AT 1024
+#define DEPTH 32
+
+int rec_active;
+void rec_close(void);
+static FILE *out;
+static uint32_t at_off[MAX_AT], inner_off[MAX_AT];
+static unsigned n_at, n_inner, max_per = 20;
+static unsigned at_count[MAX_AT], at_seen[MAX_AT], at_next[MAX_AT];
+static uint8_t *before;         /* memory before a DOS or BIOS call */
+static uint32_t ign_lo[64], ign_hi[64];
+static unsigned n_ign;
+static int ignoring;            /* inside EMU2_RECORD_IGNORE code (or what it called) */
+static unsigned ign_ss, ign_sp;
+static int cur_in_ign;          /* the instruction running is the ignored code's own (or DOS it called) */
+
+struct frame {
+    int child;                  /* a call of an EMU2_RECORD_INNER function */
+    uint8_t *state;             /* per byte: 1 read recorded, 2 written */
+    uint32_t *touched;          /* bytes whose state is set, to clear them afterwards */
+    unsigned n_touched, cap_touched;
+    uint8_t *in_val;            /* the value of each recorded read */
+    uint16_t entry[13];
+    uint8_t stack[32];
+    unsigned at, seq, entry_cs, ret_ip, ret_cs, steps, bios, min_sp;
+    uint32_t ret_prov_far, ret_prov_near;   /* where the return address's code came from */
+    unsigned children;          /* children so far (recorded calls) */
+    int lost;                   /* a call inside it came when the frames were all in use */
+    int ret_seen;               /* it has executed its return (a ret with SP at its return address) */
+    /* a recorded call: bytes the ignored code wrote while no child was active, kept for the
+       next child (or the end of the call) */
+    uint32_t *ext;
+    unsigned n_ext, cap_ext;
+    uint8_t *ext_seen;
+    /* a child: those bytes for each parent, with their values when the child started */
+    struct ext_byte { int level; uint32_t addr; uint8_t val; } *cx;
+    unsigned n_cx, cap_cx;
+};
+static struct frame fr[DEPTH];
+static int depth;
+
+static int parse_list(const char *s, uint32_t *list, unsigned max)
+{
+    unsigned n = 0;
+    for(char *p = (char *)s; p && *p && n < max;)
+    {
+        list[n++] = strtoul(p, &p, 16);
+        while(*p == ',' || *p == ' ')
+            p++;
+    }
+    return n;
+}
+
+void rec_init(void)
+{
+    const char *e = getenv("EMU2_RECORD"), *a = getenv("EMU2_RECORD_AT");
+    if(!e || !*e || !a || !*a)
+        return;
+    char name[4096];
+    snprintf(name, sizeof name, "%s.%d", e, (int)getpid());
+    out = fopen(name, "w");
+    before = malloc(MEM);
+    if(!out || !before)
+    {
+        out = 0;
+        return;
+    }
+    n_at = parse_list(a, at_off, MAX_AT);
+    n_inner = parse_list(getenv("EMU2_RECORD_INNER"), inner_off, MAX_AT);
+    for(char *p = getenv("EMU2_RECORD_IGNORE"); p && *p && n_ign < 64;)
+    {
+        ign_lo[n_ign] = strtoul(p, &p, 16);
+        ign_hi[n_ign] = *p == '-' ? strtoul(p + 1, &p, 16) : ign_lo[n_ign];
+        n_ign++;
+        while(*p == ',' || *p == ' ')
+            p++;
+    }
+    if(getenv("EMU2_RECORD_MAX"))
+        max_per = strtoul(getenv("EMU2_RECORD_MAX"), 0, 10);
+    trace_need();
+    atexit(rec_close);
+}
+
+static void touch(struct frame *f, uint32_t a, uint8_t bit)
+{
+    if(!f->state[a])
+    {
+        if(f->n_touched == f->cap_touched)
+        {
+            f->cap_touched = f->cap_touched ? 2 * f->cap_touched : 4096;
+            f->touched = realloc(f->touched, f->cap_touched * sizeof *f->touched);
+        }
+        f->touched[f->n_touched++] = a;
+    }
+    f->state[a] |= bit;
+}
+
+void rec_read(uint32_t addr, unsigned n)
+{
+    if(ignoring)
+        return;
+    for(int l = 0; l < depth; l++)
+    {
+        struct frame *f = &fr[l];
+        for(unsigned i = 0; i < n; i++)
+        {
+            uint32_t a = (addr + i) & (MEM - 1);
+            if(!f->state[a])
+            {
+                f->in_val[a] = memory[a];
+                touch(f, a, 1);
+            }
+        }
+    }
+}
+
+static void add_ext(struct frame *f, uint32_t a)
+{
+    if(!f->ext_seen)
+        f->ext_seen = calloc(MEM, 1);
+    if(!f->ext_seen || f->ext_seen[a])
+        return;
+    f->ext_seen[a] = 1;
+    if(f->n_ext == f->cap_ext)
+    {
+        f->cap_ext = f->cap_ext ? 2 * f->cap_ext : 1024;
+        f->ext = realloc(f->ext, f->cap_ext * sizeof *f->ext);
+    }
+    f->ext[f->n_ext++] = a;
+}
+
+static void clear_ext(struct frame *f)
+{
+    for(unsigned i = 0; i < f->n_ext; i++)
+        f->ext_seen[f->ext[i]] = 0;
+    f->n_ext = 0;
+}
+
+void rec_write(uint32_t addr, unsigned n)
+{
+    if(ignoring && !cur_in_ign)
+    {
+        /* the program's own code, called back by the ignored code (the overlay manager
+           asking for memory: pools moved), changing state the calls open now go on to use
+           at a moment no replay can know: none of them is written */
+        for(int l = 0; l < depth; l++)
+            fr[l].lost = 1;
+    }
+    if(ignoring)
+    {
+        /* the ignored code's writes: part of the effect of a child that is running, or
+           external writes of the recorded calls, applied by a replay before their next child */
+        for(unsigned i = 0; i < n; i++)
+        {
+            uint32_t a = (addr + i) & (MEM - 1);
+            if(depth && fr[depth - 1].child)
+                for(int l = 0; l < depth; l++)
+                    touch(&fr[l], a, 2);
+            else
+                for(int l = 0; l < depth; l++)
+                    add_ext(&fr[l], a);
+        }
+        return;
+    }
+    for(int l = 0; l < depth; l++)
+        for(unsigned i = 0; i < n; i++)
+            touch(&fr[l], (addr + i) & (MEM - 1), 2);
+}
+
+void rec_bios(void)
+{
+    if(!rec_active)
+        return;
+    /* a DOS call of the ignored code (the overlay manager reading an overlay) is not one
+       of the recorded calls' own, but what it changes is recorded like the ignored code's
+       other writes */
+    if(!ignoring)
+        for(int l = 0; l < depth; l++)
+            fr[l].bios++;
+    memcpy(before, memory, MEM);
+}
+
+/* after a DOS or BIOS call: what it changed counts as written */
+void rec_bios_done(void)
+{
+    if(!rec_active)
+        return;
+    /* from the program image up: below it are DOS, the BIOS and the PSP (DOS keeps the caller.s
+       stack there on each call), which an
+       interrupt (the timer) may change at any moment */
+    uint32_t low = trace_load_seg * 16u;
+    for(uint32_t a = low; a < MEM; a++)
+        if(memory[a] != before[a])
+            rec_write(a, 1);
+}
+
+static int cmp_u32(const void *a, const void *b)
+{
+    uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* runs of consecutive addresses with the given state bit, written as "K lin bytes" */
+static void runs(struct frame *f, char kind, uint8_t bit, const uint8_t *val, uint32_t skip_lo,
+                 uint32_t skip_hi)
+{
+    unsigned i = 0;
+    while(i < f->n_touched)
+    {
+        uint32_t a = f->touched[i];
+        if(!(f->state[a] & bit) || (a >= skip_lo && a < skip_hi))
+        {
+            i++;
+            continue;
+        }
+        fprintf(out, "%c %05X ", kind, a);
+        uint32_t next = a;
+        while(i < f->n_touched && f->touched[i] == next && (f->state[next] & bit) &&
+              !(next >= skip_lo && next < skip_hi))
+        {
+            fprintf(out, "%02X", val[next]);
+            next++;
+            i++;
+        }
+        fputc('\n', out);
+    }
+}
+
+static int cmp_ext(const void *a, const void *b)
+{
+    const struct ext_byte *x = a, *y = b;
+    return x->addr < y->addr ? -1 : x->addr > y->addr;
+}
+
+/* external bytes as runs "X lin bytes" */
+static void ext_runs(struct ext_byte *e, unsigned n)
+{
+    qsort(e, n, sizeof *e, cmp_ext);
+    for(unsigned i = 0; i < n;)
+    {
+        fprintf(out, "X %05X ", e[i].addr);
+        uint32_t next = e[i].addr;
+        while(i < n && e[i].addr == next)
+        {
+            fprintf(out, "%02X", e[i].val);
+            next++;
+            i++;
+        }
+        fputc('\n', out);
+    }
+}
+
+static void regs(const char *kind, const uint16_t *r)
+{
+    fprintf(out, "%s", kind);
+    for(int i = 0; i < 13; i++)
+        fprintf(out, " %04X", r[i]);
+    fputc('\n', out);
+}
+
+/* keep a finished call?  The first max/2 calls; then calls that had children (the rare
+   paths, such as a pool that grows); and a sample spread over the run, each one twice as far
+   on as the last, so late calls are seen too */
+static int keep(struct frame *f)
+{
+    unsigned seen = f->seq;
+    if(at_count[f->at] >= max_per)
+        return 0;
+    if(at_count[f->at] < max_per / 2 || f->children)
+        return 1;
+    if(seen >= at_next[f->at])
+    {
+        at_next[f->at] = seen * 2;
+        return 1;
+    }
+    return 0;
+}
+
+/* end the innermost frame, writing its record if it is kept */
+static void finish(void)
+{
+    struct frame *f = &fr[--depth];
+    if(!f->lost && (f->child || keep(f)))
+    {
+        uint16_t now[13];
+        cpuGetState(now);
+        qsort(f->touched, f->n_touched, sizeof *f->touched, cmp_u32);
+        if(!f->child)
+            fprintf(out, "CALL %X %u\n", at_off[f->at], f->seq);
+        else
+        {
+            fprintf(out, "CALL %X 0\n", inner_off[f->at]);
+            /* parents: the enclosing recorded calls up to the next child */
+            for(int l = depth - 1; l >= 0 && !fr[l].child; l--)
+            {
+                fprintf(out, "PARENT %X %u %u\n", at_off[fr[l].at], fr[l].seq, fr[l].children++);
+                struct ext_byte *mine = malloc((f->n_cx + 1) * sizeof *mine);
+                unsigned k = 0;
+                for(unsigned i = 0; i < f->n_cx; i++)
+                    if(f->cx[i].level == l)
+                        mine[k++] = f->cx[i];
+                ext_runs(mine, k);
+                free(mine);
+            }
+        }
+        regs("IN ", f->entry);
+        fprintf(out, "S ");
+        for(int i = 0; i < 32; i++)
+            fprintf(out, "%02X", f->stack[i]);
+        fputc('\n', out);
+        runs(f, 'R', 1, f->in_val, 1, 0);
+        regs("OUT", now);
+        uint32_t ss = f->entry[10] * 16u;
+        runs(f, 'W', 2, memory, ss + f->min_sp, ss + f->entry[4]);
+        if(!f->child && f->n_ext)
+        {
+            struct ext_byte *e = malloc(f->n_ext * sizeof *e);
+            for(unsigned i = 0; i < f->n_ext; i++)
+                e[i] = (struct ext_byte){0, f->ext[i], memory[f->ext[i]]};
+            ext_runs(e, f->n_ext);
+            free(e);
+        }
+        fprintf(out, "STEPS %u\n", f->steps);
+        fprintf(out, "FRAME %04X\n", f->min_sp);
+        if(f->bios)
+            fprintf(out, "BIOS %u\n", f->bios);
+        fprintf(out, "END\n");
+        if(!f->child)
+            at_count[f->at]++;
+    }
+    for(unsigned i = 0; i < f->n_touched; i++)
+        f->state[f->touched[i]] = 0;
+    f->n_touched = 0;
+    if(f->ext_seen)
+        clear_ext(f);
+    f->n_cx = 0;
+    rec_active = depth > 0;
+}
+
+static void start(int child, unsigned at, unsigned cs)
+{
+    if(depth == DEPTH)
+    {
+        /* a call that cannot be followed: every enclosing record would miss it and what
+           it did, so none of them is written */
+        for(int l = 0; l < depth; l++)
+            fr[l].lost = 1;
+        return;
+    }
+    struct frame *f = &fr[depth];
+    if(!f->state)
+    {
+        f->state = calloc(MEM, 1);
+        f->in_val = malloc(MEM);
+        if(!f->state || !f->in_val)
+        {
+            out = 0;
+            return;
+        }
+    }
+    f->n_cx = 0;
+    if(child)
+        for(int l = depth - 1; l >= 0 && !fr[l].child; l--)
+        {
+            for(unsigned i = 0; i < fr[l].n_ext; i++)
+            {
+                if(f->n_cx == f->cap_cx)
+                {
+                    f->cap_cx = f->cap_cx ? 2 * f->cap_cx : 1024;
+                    f->cx = realloc(f->cx, f->cap_cx * sizeof *f->cx);
+                }
+                f->cx[f->n_cx++] = (struct ext_byte){l, fr[l].ext[i], memory[fr[l].ext[i]]};
+            }
+            if(fr[l].ext_seen)
+                clear_ext(&fr[l]);
+        }
+    depth++;
+    f->child = child;
+    f->at = at;
+    f->seq = child ? 0 : at_seen[at]++;
+    cpuGetState(f->entry);
+    f->entry_cs = cs;
+    uint32_t sp = f->entry[10] * 16u + f->entry[4];
+    for(int i = 0; i < 32; i++)
+        f->stack[i] = memory[(sp + i) & (MEM - 1)];
+    f->ret_ip = f->stack[0] | f->stack[1] << 8;
+    f->ret_cs = f->stack[2] | f->stack[3] << 8;
+    f->ret_prov_far = trace_prov[(f->ret_cs * 16u + f->ret_ip) & (MEM - 1)];
+    f->ret_prov_near = trace_prov[(cs * 16u + f->ret_ip) & (MEM - 1)];
+    f->steps = 1;
+    f->bios = 0;
+    f->min_sp = f->entry[4];
+    f->children = 0;
+    f->lost = 0;
+    f->ret_seen = 0;
+    rec_active = 1;
+}
+
+/* has the call of this frame returned?  The return address may have moved: when the heap
+   moves an overlay, the overlay manager rewrites return addresses into it, so the caller's
+   code is also known by where it came from in the program file. */
+static int returned(struct frame *f, unsigned cs, unsigned ip, uint32_t prov)
+{
+    if(ip != f->ret_ip || cpuGetSS() != f->entry[10] || cpuGetSP() <= f->entry[4])
+        return 0;
+    return cs == f->ret_cs || cs == f->entry_cs ||
+           (prov && (prov == f->ret_prov_far || prov == f->ret_prov_near));
+}
+
+void rec_step(unsigned cs, unsigned ip, uint32_t prov)
+{
+    if(!out)
+        return;
+    /* the call that executed its own return last step has returned, wherever that took
+       execution: the overlay manager may have moved the caller's code meanwhile and given
+       it a return address that neither its segment nor its provenance would recognise */
+    if(depth && fr[depth - 1].ret_seen)
+        finish();
+    while(depth)
+    {
+        struct frame *t = &fr[depth - 1];
+        if(returned(t, cs, ip, prov))
+            finish();
+        else if(cpuGetSS() == t->entry[10] && cpuGetSP() > t->entry[4] + 0x40)
+        {
+            /* the stack is far above the call's return address and it did not return: a
+               long jump unwound it (a compile restarted).  Neither it nor any call around
+               it can be replayed, so none of them is written */
+            for(int l = 0; l < depth; l++)
+                fr[l].lost = 1;
+            finish();
+        }
+        else
+            break;
+    }
+    unsigned sp = cpuGetSP();
+    if(depth && sp == fr[depth - 1].entry[4] && cpuGetSS() == fr[depth - 1].entry[10])
+    {
+        uint8_t op = memory[(cs * 16u + ip) & (MEM - 1)];
+        if(op == 0xC2 || op == 0xC3 || op == 0xCA || op == 0xCB)
+            fr[depth - 1].ret_seen = 1;
+    }
+    if(n_ign)
+    {
+        int in_ign = 0;
+        for(unsigned i = 0; prov && i < n_ign; i++)
+            if(prov - 1 >= ign_lo[i] && prov - 1 <= ign_hi[i])
+                in_ign = 1;
+        if(prov)
+            cur_in_ign = in_ign;
+        if(ignoring && !in_ign && cpuGetSS() == ign_ss && sp >= ign_sp)
+            ignoring = 0;
+        else if(!ignoring && in_ign)
+        {
+            ignoring = 1;
+            ign_ss = cpuGetSS();
+            ign_sp = sp;
+        }
+    }
+    for(int l = 0; l < depth; l++)
+    {
+        fr[l].steps++;
+        if(sp < fr[l].min_sp)
+            fr[l].min_sp = sp;
+    }
+    if(!prov || ignoring || (depth && fr[depth - 1].child))
+        return;
+    if(depth)
+        for(unsigned i = 0; i < n_inner; i++)
+            if(inner_off[i] == prov - 1)
+            {
+                start(1, i, cs);
+                return;
+            }
+    for(unsigned i = 0; i < n_at; i++)
+        if(at_off[i] == prov - 1)
+        {
+            if(at_count[i] < max_per)
+                start(0, i, cs);
+            else
+                at_seen[i]++;
+            return;
+        }
+}
+
+void rec_close(void)
+{
+    if(out)
+        fclose(out);
+    out = 0;
+}
