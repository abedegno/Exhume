diff --git a/src/trace.c b/src/trace.c
new file mode 100644
index 0000000..ca9b444
--- /dev/null
+++ b/src/trace.c
@@ -0,0 +1,174 @@
+/* Provenance tracing for emu2 (Exhume): which words of the program file are used as
+ * addresses, and which bytes of it are executed.
+ *
+ * Enabled by EMU2_TRACE=OUTFILE.  Every byte of memory carries the program-file offset it
+ * was loaded from (+1; 0 = not from the file).  A word register loaded from memory carries
+ * that word's provenance, and stores pass it on, so a value read from a data table keeps
+ * the table entry's file offset however it is copied.  Then:
+ *   P off n  - the word at file offset off was used n times as an address (a base or index
+ *              register of a memory operand, or SI/DI/BX of a string or xlat instruction);
+ *   C off n  - the word at off was used n times as a near code address (call/jmp through a
+ *              register or memory);
+ *   E off    - the instruction starting at file offset off was executed.
+ * The output is written to OUTFILE.PID at exit.
+ *
+ * EMU2_TRACE_DGROUP=XXXX (hex paragraphs from the load segment) limits P to uses through that
+ * segment with a displacement under 100h, by a register that still holds (about) the word
+ * loaded.  A register keeps the provenance of the word it was loaded from while it is moved
+ * or moved on by add, sub, inc and dec; any other change (a byte written into it, a shift, a
+ * logic operation, a multiply) clears it (trace_settle in cpu.c).
+ * EMU2_TRACE_WATCH=OFF (hex file offset) prints to stderr the file offset of the instruction
+ * behind each of the first uses of the word at OFF: how a P line came about.
+ * EMU2_TRACE_READ=LO-HI (hex file offsets) prints to stderr, once each, the instructions that
+ * read bytes loaded from LO..HI: who reads a table, whatever address they use. */
+#include "trace.h"
+#include "emu.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define FILE_MAX (1u << 20)
+
+int trace_on;
+uint32_t trace_prov[1u << 20];
+uint32_t trace_rt[8];
+uint32_t trace_last_rd, trace_last_rdb, trace_wt, trace_bt;
+uint32_t trace_ea_t[2];
+uint16_t trace_ea_v[2];
+unsigned trace_dgroup = 0x10000;
+static uint32_t *ptr_use, *code_use;
+static uint8_t *exec_mark;
+static uint8_t *orig_img;   /* the program file bytes as loaded, by file offset */
+static dev_t prog_dev;
+static ino_t prog_ino;
+static char *out_name;
+static long watch = -1;
+uint32_t trace_rd_lo = 1, trace_rd_hi = 0;
+static uint8_t *rd_seen;
+static uint32_t cur_lin;
+
+static void trace_dump(void)
+{
+    char name[4096];
+    snprintf(name, sizeof name, "%s.%d", out_name, (int)getpid());
+    FILE *f = fopen(name, "w");
+    if(!f)
+        return;
+    for(uint32_t i = 0; i < FILE_MAX; i++)
+    {
+        if(ptr_use[i])
+            fprintf(f, "P %X %u\n", i, ptr_use[i]);
+        if(code_use[i])
+            fprintf(f, "C %X %u\n", i, code_use[i]);
+        if(exec_mark[i])
+            fprintf(f, "E %X\n", i);
+    }
+    fclose(f);
+}
+
+void trace_init(void)
+{
+    const char *e = getenv("EMU2_TRACE");
+    if(!e || !*e)
+        return;
+    out_name = strdup(e);
+    ptr_use = calloc(FILE_MAX, sizeof(uint32_t));
+    code_use = calloc(FILE_MAX, sizeof(uint32_t));
+    exec_mark = calloc(FILE_MAX, 1);
+    orig_img = calloc(FILE_MAX + 2, 1);
+    if(!ptr_use || !code_use || !exec_mark || !orig_img)
+        return;
+    trace_on = 1;
+    if(getenv("EMU2_TRACE_READ"))
+    {
+        char *e;
+        trace_rd_lo = strtoul(getenv("EMU2_TRACE_READ"), &e, 16) + 1;
+        trace_rd_hi = (*e == '-' ? strtoul(e + 1, 0, 16) : trace_rd_lo - 1) + 1;
+        rd_seen = calloc(FILE_MAX, 1);
+    }
+    if(getenv("EMU2_TRACE_WATCH"))
+        watch = strtol(getenv("EMU2_TRACE_WATCH"), 0, 16);
+    atexit(trace_dump);
+}
+
+void trace_program(FILE *f)
+{
+    struct stat st;
+    if(trace_on && !fstat(fileno(f), &st))
+    {
+        prog_dev = st.st_dev;
+        prog_ino = st.st_ino;
+    }
+}
+
+void trace_loaded(FILE *f, long pos, uint32_t addr, unsigned n)
+{
+    struct stat st;
+    int ours = trace_on && pos >= 0 && !fstat(fileno(f), &st) && st.st_dev == prog_dev &&
+               st.st_ino == prog_ino;
+    for(unsigned i = 0; i < n; i++)
+    {
+        trace_prov[(addr + i) & 0xFFFFF] = ours ? (uint32_t)(pos + i + 1) : 0;
+        if(ours && pos + i < FILE_MAX)
+            orig_img[pos + i] = memory[(addr + i) & 0xFFFFF];
+    }
+}
+
+void trace_use(uint32_t t)
+{
+    if(t && t <= FILE_MAX)
+    {
+        ptr_use[t - 1]++;
+        if((long)(t - 1) == watch && ptr_use[t - 1] < 20)
+            fprintf(stderr, "watch: use at file %X\n", trace_prov[cur_lin & 0xFFFFF] - 1);
+    }
+}
+
+/* A use counts as an address of a DGROUP item when it goes through DGROUP (EMU2_TRACE_DGROUP:
+ * the paragraph of DGROUP relative to the load segment) with a displacement under 100h from
+ * the loaded value: a pointer to an item or a field of it, not an index into a table. */
+void trace_use_at(uint32_t t, unsigned seg, uint16_t disp, uint16_t value)
+{
+    if(!t || t > FILE_MAX || seg != trace_dgroup || disp >= 0x100)
+        return;
+    /* the register must still hold (about) the word stored at t: a pointer, perhaps moved on
+       through its item, not a number computed from it */
+    uint16_t stored = orig_img[t - 1] | (orig_img[t] << 8);
+    if(stored >= 0x40 && (uint16_t)(value - stored) < 0x100)
+        trace_use(t);
+}
+
+void trace_set_load(unsigned load_seg)
+{
+    const char *e = getenv("EMU2_TRACE_DGROUP");
+    if(trace_on && e)
+        trace_dgroup = load_seg + (unsigned)strtoul(e, 0, 16);
+}
+
+void trace_code(uint32_t t)
+{
+    if(t && t <= FILE_MAX)
+        code_use[t - 1]++;
+}
+
+void trace_exec(uint32_t lin)
+{
+    cur_lin = lin;
+    uint32_t t = trace_prov[lin & 0xFFFFF];
+    if(t && t <= FILE_MAX)
+        exec_mark[t - 1] = 1;
+}
+
+/* EMU2_TRACE_READ=LO-HI: report once each instruction that reads a byte loaded from file
+   offsets LO..HI, with the offset read */
+void trace_read(uint32_t t)
+{
+    uint32_t at = trace_prov[cur_lin & 0xFFFFF];
+    if(at && at <= FILE_MAX && !rd_seen[at - 1])
+    {
+        rd_seen[at - 1] = 1;
+        fprintf(stderr, "read: instruction at file %X reads file %X\n", at - 1, t - 1);
+    }
+}
