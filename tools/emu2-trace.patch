+/* After an instruction: a register whose value it changed keeps its provenance only when
+   the instruction moves a word into it (which sets the provenance itself) or moves a
+   pointer on by adding or subtracting (add, sub, inc, dec, the string instructions);
+   anything else (a byte written into it, a shift, a logic operation, a multiply) leaves a
+   number that is no longer the word it was loaded from. */
+static void trace_settle(unsigned cs, uint16_t at, const uint16_t *old_v, const uint32_t *old_t)
+{
+    uint8_t op, m;
+    for(int i = 0; i < 4; i++)
+    {
+        op = memory[(cs * 16 + at) & 0xFFFFF];
+        if(op != 0x26 && op != 0x2E && op != 0x36 && op != 0x3E && op != 0xF2 && op != 0xF3)
+            break;
+        at++;
+    }
+    m = memory[(cs * 16 + at + 1) & 0xFFFFF];
+    int keep = 0;
+    switch(op)
+    {
+    case 0x01: case 0x03: case 0x05: case 0x29: case 0x2B: case 0x2D:   /* add, sub */
+    case 0x87: case 0x89: case 0x8B: case 0x8D: case 0x91: case 0x92: case 0x93:
+    case 0x94: case 0x95: case 0x96: case 0x97: case 0xA1: case 0xC4: case 0xC5:
+    case 0xA4: case 0xA5: case 0xA6: case 0xA7: case 0xAA: case 0xAB: case 0xAD:
+    case 0xAE: case 0xAF: case 0x9C: case 0x9D: case 0xCD: case 0x61:
+        keep = 1;
+        break;
+    case 0x81: case 0x83:
+        keep = ((m >> 3) & 7) == 0 || ((m >> 3) & 7) == 5;              /* add, sub */
+        break;
+    case 0xFF:
+        keep = ((m >> 3) & 7) <= 1 || ((m >> 3) & 7) == 6;              /* inc, dec, push */
+        break;
+    default:
+        keep = (op >= 0x40 && op <= 0x5F) || (op >= 0xB8 && op <= 0xBF);
+    }
+    if(keep)
+        return;
+    for(int r = 0; r < 8; r++)
+        if(wregs[r] != old_v[r] && trace_rt[r] == old_t[r])
+            trace_rt[r] = 0;
+}
